      "quality_rules": [
        {
          "id": "ap-k-invoice-id-format",
          "description": "invoice_id deve casar com master_entity invoice",
          "severity": "error",
          "expression": "REGEXP_MATCH(invoice_id, '^INV-[0-9]+$')"
        },
        {
          "id": "ap-k-positive-amount",
          "description": "amount > 0",
          "severity": "error",
          "expression": "amount > 0"
        },
        {
          "id": "ap-k-currency-brl",
          "description": "currency BRL",
          "severity": "error",
          "expression": "currency == 'BRL'"
        },
        {
          "id": "ap-k-valid-status",
          "description": "status válido",
          "severity": "error",
          "expression": "status IN ['OPEN','PAID','CANCELED']"
        }
      ],
