      "schema": {
        "registry": "http://schema-registry:8081",
        "subject": "logistics-invoice-v1",
        "format": "avro",
        "evolution_policy": "backward_compatible",
        "breaking_changes": "require_major_version",
        "deprecation_period": "P90D"
      },
      "sla": {
        "freshness": "P1D",
        "availability": "99.0%",
        "latency": "PT5S",
        "throughput": "100 msg/s"
      },
      "dataset_fields": [
        {
          "name": "invoice_id",
          "type": "string",
          "required": true,
          "description": "Master entity (federated), pode ter N operações"
        },
        {
          "name": "qtd_operacoes",
          "type": "integer",
          "required": true,
          "constraints": {
            "minInclusive": 1
          }
        },
        {
          "name": "valor_base",
          "type": "number",
          "required": true,
          "description": "Custo base do item/serviço logístico. Semântica específica do domínio Logística; não corresponde ao valor_base dos produtos financeiros (AP/AR)."
        },
        {
          "name": "valor_frete",
          "type": "number",
          "required": true,
          "description": "Custo de frete da operação"
        },
        {
          "name": "valor_seguro",
          "type": "number",
          "required": true,
          "description": "Custo de seguro da operação"
        },
        {
          "name": "valor_imposto",
          "type": "number",
          "required": true,
          "description": "Valor de impostos da operação"
        },
        {
          "name": "valor_total",
          "type": "number",
          "required": true,
          "description": "Soma de valor_base + valor_frete + valor_seguro + valor_imposto"
        },
        {
          "name": "dsc_tipo_operacao",
          "type": "array",
          "required": true
        },
        {
          "name": "status",
          "type": "array",
          "required": true,
          "description": "Estado atual da fatura"
        },
        {
          "name": "meses_operacao",
          "type": "array",
          "required": true
        },
        {
          "name": "dsc_moeda",
          "type": "string",
          "required": true,
          "enum": [
            "BRL"
          ]
        },
        {
          "name": "dsc_dominio",
          "type": "string",
          "required": true
        },
        {
          "name": "dsc_produto",
          "type": "string",
          "required": true
        },
        {
          "name": "dt_versao",
          "type": "string",
          "required": true,
          "description": "Timestamp de geração do output port analítico (ISO 8601)"
        },
        {
          "name": "dsc_cidade",
          "type": "string",
          "required": true,
          "description": "Cidade para onde a encomenda foi enviada"
        },
        {
          "name": "dsc_uf",
          "type": "string",
          "required": true,
          "description": "Estado para onde a encomenda foi enviada"
        }
      ],
      "quality_rules": [
        {
          "id": "log-k-invoice-id-format",
          "description": "invoice_id deve casar com master_entity invoice",
          "severity": "error",
          "expression": "REGEXP_MATCH(invoice_id, '^INV-[0-9]+$')"
        },
        {
          "id": "log-k-total-decomposition",
          "description": "valor_total deve igualar a soma de seus componentes",
          "severity": "error",
          "expression": "ABS(valor_base + valor_frete + valor_seguro + valor_imposto - valor_total) <= 0.01"
        },
        {
          "id": "log-k-positive-count",
          "description": "qtd_operacoes >= 1",
          "severity": "error",
          "expression": "qtd_operacoes >= 1"
        },
        {
          "id": "log-k-currency-brl",
          "description": "moeda BRL",
          "severity": "error",
          "expression": "dsc_moeda == 'BRL'"
        },
        {
          "id": "log-k-valid-status",
          "description": "status válido em pelo menos uma operação",
          "severity": "error",
          "expression": "ANY(status, s => s IN ['PENDENTE','EM_PROCESSAMENTO','CONCLUIDO','CANCELADO'])"
        }
      ],
      "consumers": [
        {
          "name": "cross-domain-reconciliation",
